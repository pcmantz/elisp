# .gitignore
#
# helpful ignores for emacs

# compiled files
*.elc
**/.yas-compiled-snippets.el

# top-level local config files
/.mc-lists.el
/bookmarks
/ido.last
/lisp/my-custom-file.el
/my-custom-file.el

# caches
/.lsp-session-*
/forge-database.sqlite
/history
/network-security.data
/perspective
/projectile-*
/projectile-bookmarks.eld
/projectile.cache
/projects
/projects.eld
/rake.cache
/recentf
/session.*
/smex-items
/tramp
/workgroups

# various temp dirs
/auto-save-list/
/eln-cache/
/elpa/
/elpaca/
/eshell/
/request/
/transient/
/tree-sitter/
/url/
/var/

# AI-related files
.aider*

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
